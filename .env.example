# CBC Copilot configuration (§8.4).
#
# Precedence: process env -> SSM Parameter Store (staging/prod) -> this file
# (local only) -> defaults in shared/config.py. The application FAILS TO START on
# a missing required variable; it never silently defaults.
#
# Copy to .env for local development. No secrets belong in this file.

# ── Environment ──────────────────────────────────────────────────────────────
# local | dev | staging | prod. Gates the NIM escape hatch and SSM hydration.
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Database (required — no fallback engine, D2) ─────────────────────────────
DATABASE_URL=postgresql://postgres:password@postgres:5432/cbccopilot
# 0 is correct behind PgBouncer in transaction mode (bottleneck B10).
DB_CONN_MAX_AGE=0

# ── Django ───────────────────────────────────────────────────────────────────
# Required outside local. Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
# SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── AWS (required) ───────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# MiniStack only. shared/config.py REFUSES this in staging/prod, where it would
# silently bypass every real AWS service.
# NOT AWS_ENDPOINT_URL: botocore applies that name to every service, Bedrock
# and Textract included, and a redirected Bedrock call returns a MiniStack
# mock instead of failing. config.py refuses the standard name.
LOCAL_AWS_ENDPOINT_URL=http://ministack:4566
S3_SOURCE_BUCKET=cbc-copilot-source-local
S3_DERIVED_BUCKET=cbc-copilot-derived-local
CLOUDFRONT_DOMAIN=

# ── Queues (C6: standard SQS + DLQ; FIFO is not warranted here) ──────────────
DOCUMENT_READY_QUEUE=document-ready
DOCUMENT_READY_DLQ=document-ready-dlq
OCR_COMPLETE_QUEUE=ocr-complete
SQS_VISIBILITY_TIMEOUT_SECONDS=900
SQS_MAX_RECEIVE_COUNT=3
# Completion arrives via SNS, never a polling loop (bottleneck B2).
TEXTRACT_SNS_TOPIC_ARN=
TEXTRACT_SNS_ROLE_ARN=

# ── Bedrock (C5/D12: NEVER hardcode a model ID) ──────────────────────────────
# Resolved at deploy time from bedrock:ListFoundationModels /
# ListInferenceProfiles and pinned in SSM. Left blank on purpose: a wrong pinned
# ID silently changes what produced a quote. Run `make bedrock-resolve`.
BEDROCK_MODEL_ID=
BEDROCK_MODEL_ID_CHEAP=
BEDROCK_MAX_TOKENS=8192
# temperature=0 is a correctness requirement, not a tuning knob (§5.4).
BEDROCK_TEMPERATURE=0
BEDROCK_TOP_P=1.0
EXTRACTION_PROMPT_VERSION=v1
LOCATE_PROMPT_VERSION=v1

# ── Extraction thresholds (§5.9) ─────────────────────────────────────────────
# 0.80 is a PLACEHOLDER until calibration replaces it with a measured value CBC
# chooses, expressed as "flag X% of fields, let through ~1 error per Y" (C14/R7).
CONFIDENCE_THRESHOLD_DEFAULT=0.80
# Stricter, and validated as such at start-up: the cost of a wrong fire rating or
# handing is categorically different (§5.8).
CONFIDENCE_THRESHOLD_FIRE_RATING=0.95
CONFIDENCE_THRESHOLD_HANDING=0.95
# rapidfuzz.partial_ratio floor for value grounding. Tolerates OCR noise and
# hyphenation; never a semantic comparison (§5.6).
GROUNDING_MIN_RATIO=90

# ── Preprocessing (§4) ───────────────────────────────────────────────────────
# The routing table is CONFIGURATION, not `if` statements, so Open Item 9 lands as
# a config change rather than a code change (Risk R1).
OCR_ROUTE_CONFIG=config/ocr_routes.json
# Hard budget guard. The only control that catches "someone uploaded a 3,000-page
# set by mistake" BEFORE the money is gone (§10.3).
MAX_OCR_COST_PER_DOCUMENT_USD=2.00
SPLIT_MAX_PAGES=1000
RASTER_MAX_LONG_EDGE_PX=4000

# ── Matching (§6.1) ──────────────────────────────────────────
# Top-N mirrors the estimator behaviour CBC validated: "here are 3 close
# matches - is it one of these?"
MATCH_TOP_N=3
# Below this, route to the manual/custom path rather than auto-proposing a line
# (NR-13). Calibrate like every other threshold; this is a starting point.
MATCH_CONFIDENCE_CUTOFF=0.60
MATCH_SIZE_TOLERANCE_INCHES=2

# ── Pricing (§6.2) ───────────────────────────────────────────────────────────
# Cost data older than this is stale, discarded, and refreshed. Configurable, not
# hardcoded; the exact window is CBC's to set (Open Item 15).
COST_FRESHNESS_MONTHS=8

# ── Local LLM escape hatch (§11.1, open item Q2) ─────────────────────────────
# LOCAL ONLY. shared/config.py raises if any of these is set outside
# ENVIRONMENT=local: NIM must never become a second extraction path.
NIM_BASE_URL=
NIM_API_KEY=
NIM_CHAT_MODEL=

# ── Offline loop (§8.3) ──────────────────────────────────────
# Replay OCR from the PDF's own text layer instead of calling Textract. Runs the
# whole pipeline with no AWS calls and no spend. shared/config.py REFUSES this
# outside ENVIRONMENT=local.
FAKE_OCR=0
